      <!-- ===================== Fluxo completo (modelo aberto) ===================== -->
      <!-- docsSchedule vem do calc_carga.py, ex.: rate(8.4/min) random_arrivals(30 min) pause(10 min).
           O padrão pause(1 s) não gera chegada nenhuma (pipeline desligado). -->
      <OpenModelThreadGroup guiclass="OpenModelThreadGroupGui" testclass="OpenModelThreadGroup" testname="Fluxo completo">
        <elementProp name="ThreadGroup.main_controller" elementType="OpenModelThreadGroupController"/>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <stringProp name="OpenModelThreadGroup.schedule">${__P(docsSchedule,pause(1 s))}</stringProp>
        <stringProp name="OpenModelThreadGroup.random_seed"></stringProp>
      </OpenModelThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Chegada: sorteia o PDF (não medido)">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">import org.apache.jmeter.services.FileServer

def base = FileServer.getFileServer().getBaseDir()
def abs = { String p -&gt; def f = new File(p); f.isAbsolute() ? f : new File(base, p) }

// Lista de PDFs: lida uma vez e compartilhada entre as threads.
def lista = props.get("_pdfsLista")
if (lista == null) {
  synchronized (props) {
    lista = props.get("_pdfsLista")
    if (lista == null) {
      if (props.getProperty("pdf")) {
        lista = [[abs(props.getProperty("pdf")), (props.getProperty("pdfPaginas") ?: "1") as int, 1d]]
      } else {
        lista = []
        abs(props.getProperty("pdfsCsv") ?: "dados/pdfs.csv").eachLine("UTF-8") { String l -&gt;
          l = l.trim()
          if (!l || l.startsWith("#") || l.startsWith("caminho,")) return
          def c = l.split(",")*.trim()
          lista &lt;&lt; [abs(c[0]), c[1] as int, c[2] as double]
        }
      }
      lista.each { if (!it[0].exists()) throw new FileNotFoundException(it[0].path) }
      props.put("_pdfsLista", lista)
    }
  }
}

// Sorteio por peso.
double r = Math.random() * lista.sum { it[2] }
def escolhido = lista.find { r -= it[2]; r &lt; 0 } ?: lista[-1]
vars.put("pdfPath", escolhido[0].absolutePath)
vars.put("pdfNome", escolhido[0].name)
vars.put("pdfBytes", String.valueOf(escolhido[0].length()))
vars.put("pdfPaginas", String.valueOf(escolhido[1]))
vars.put("chegada", String.valueOf(System.currentTimeMillis()))
vars.put("fullStatus", "")
vars.put("pipelineStart", "")
vars.put("polls", "0")
vars.put("fullSessionId", "NOT_FOUND")
vars.put("documentId", "NOT_FOUND")
SampleResult.setIgnore()</stringProp>
          <stringProp name="cacheKey">true</stringProp>
        </JSR223Sampler>
        <hashTree/>

        <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="Chamadas à API">
        </GenericController>
        <hashTree>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Auth API">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Authorization</stringProp>
                <stringProp name="Header.value">Bearer ${apiToken}</stringProp>
              </elementProp>
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Content-Type</stringProp>
                <stringProp name="Header.value">application/json</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Fluxo - criar sessão">
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{"caso":{"titulo":"[LOAD TEST] fluxo completo: horas extras não pagas (${pdfPaginas} pág.)","areaJuridica":"TRABALHISTA","tipoCaso":"HORAS_EXTRAS"}}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
            <stringProp name="HTTPSampler.path">${apiBase}/sessions</stringProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
          </HTTPSamplerProxy>
          <hashTree>
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Idempotency-Key">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Idempotency-Key</stringProp>
                  <stringProp name="Header.value">${__UUID()}</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="ids">
              <stringProp name="JSONPostProcessor.referenceNames">fullSessionId;fullProtocolo</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.sessionId;$.protocolo</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers">1;1</stringProp>
              <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND;NOT_FOUND</stringProp>
            </JSONPostProcessor>
            <hashTree/>
          </hashTree>
          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="Se criou a sessão">
            <stringProp name="IfController.condition">${__groovy(vars.get("fullSessionId") != "NOT_FOUND")}</stringProp>
            <boolProp name="IfController.evaluateAll">false</boolProp>
            <boolProp name="IfController.useExpression">true</boolProp>
          </IfController>
          <hashTree>
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Fluxo - gerar URL de upload">
              <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
                <collectionProp name="Arguments.arguments">
                  <elementProp name="" elementType="HTTPArgument">
                    <boolProp name="HTTPArgument.always_encode">false</boolProp>
                    <stringProp name="Argument.value">{"nomeArquivoOriginal":"${pdfNome}","tipoDocumento":"PROVA_DOCUMENTAL","contentType":"application/pdf","tamanhoBytesEstimado":${pdfBytes}}</stringProp>
                    <stringProp name="Argument.metadata">=</stringProp>
                  </elementProp>
                </collectionProp>
              </elementProp>
              <stringProp name="HTTPSampler.path">${apiBase}/sessions/${fullSessionId}/documents/presign</stringProp>
              <stringProp name="HTTPSampler.method">POST</stringProp>
            </HTTPSamplerProxy>
            <hashTree>
              <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="upload">
                <stringProp name="JSONPostProcessor.referenceNames">documentId;uploadUrl</stringProp>
                <stringProp name="JSONPostProcessor.jsonPathExprs">$.documentId;$.uploadUrl</stringProp>
                <stringProp name="JSONPostProcessor.match_numbers">1;1</stringProp>
                <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND;NOT_FOUND</stringProp>
              </JSONPostProcessor>
              <hashTree/>
            </hashTree>
          </hashTree>
        </hashTree>

        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="Se gerou a URL de upload">
          <stringProp name="IfController.condition">${__groovy(vars.get("documentId") != "NOT_FOUND")}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>
          <!-- Upload direto no S3: sem o header Authorization (a URL pré-assinada já autentica). -->
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Fluxo - upload S3">
            <elementProp name="HTTPsampler.Files" elementType="HTTPFileArgs">
              <collectionProp name="HTTPFileArgs.files">
                <elementProp name="${pdfPath}" elementType="HTTPFileArg">
                  <stringProp name="File.path">${pdfPath}</stringProp>
                  <stringProp name="File.paramname"></stringProp>
                  <stringProp name="File.mimetype">application/pdf</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments"/>
            </elementProp>
            <stringProp name="HTTPSampler.path">${uploadUrl}</stringProp>
            <stringProp name="HTTPSampler.method">PUT</stringProp>
            <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
          </HTTPSamplerProxy>
          <hashTree>
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="PDF">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Content-Type</stringProp>
                  <stringProp name="Header.value">application/pdf</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>
          </hashTree>

          <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="Concluir e acompanhar">
          </GenericController>
          <hashTree>
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Auth API">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Authorization</stringProp>
                  <stringProp name="Header.value">Bearer ${apiToken}</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Fluxo - confirmar upload">
              <stringProp name="HTTPSampler.path">${apiBase}/sessions/${fullSessionId}/documents/${documentId}/complete</stringProp>
              <stringProp name="HTTPSampler.method">POST</stringProp>
            </HTTPSamplerProxy>
            <hashTree>
              <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Idempotency-Key">
                <collectionProp name="HeaderManager.headers">
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">Idempotency-Key</stringProp>
                    <stringProp name="Header.value">${__UUID()}</stringProp>
                  </elementProp>
                </collectionProp>
              </HeaderManager>
              <hashTree/>
            </hashTree>
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Fluxo - finalizar">
              <stringProp name="HTTPSampler.path">${apiBase}/sessions/${fullSessionId}/finalize</stringProp>
              <stringProp name="HTTPSampler.method">POST</stringProp>
            </HTTPSamplerProxy>
            <hashTree>
              <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Idempotency-Key">
                <collectionProp name="HeaderManager.headers">
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">Idempotency-Key</stringProp>
                    <stringProp name="Header.value">${__UUID()}</stringProp>
                  </elementProp>
                </collectionProp>
              </HeaderManager>
              <hashTree/>
              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="marca início do pipeline">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="script">if (prev.isSuccessful()) vars.put("pipelineStart", String.valueOf(System.currentTimeMillis()))</stringProp>
                <stringProp name="cacheKey">true</stringProp>
              </JSR223PostProcessor>
              <hashTree/>
            </hashTree>

            <WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="Até status final ou pipelineTimeoutSec">
              <stringProp name="WhileController.condition">${__groovy(def st = vars.get("pipelineStart"); st &amp;&amp; !(vars.get("fullStatus") in ["NOTIFIED"\,"NOTIFICATION_FAILED"\,"ANALYSIS_FAILED"\,"FAILED"\,"CANCELLED"]) &amp;&amp; System.currentTimeMillis() - (st as long) &lt; (props.getProperty("pipelineTimeoutSec") ?: "600") as long * 1000)}</stringProp>
            </WhileController>
            <hashTree>
              <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="pollSec">
                <stringProp name="ConstantTimer.delay">${__groovy((props.getProperty("pollSec") ?: "5") as int * 1000)}</stringProp>
              </ConstantTimer>
              <hashTree/>
              <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Fluxo - consultar status">
                <stringProp name="HTTPSampler.path">${apiBase}/sessions/${fullSessionId}</stringProp>
                <stringProp name="HTTPSampler.method">GET</stringProp>
              </HTTPSamplerProxy>
              <hashTree>
                <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="status">
                  <stringProp name="JSONPostProcessor.referenceNames">fullStatus</stringProp>
                  <stringProp name="JSONPostProcessor.jsonPathExprs">$.status</stringProp>
                  <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
                  <stringProp name="JSONPostProcessor.defaultValues"></stringProp>
                </JSONPostProcessor>
                <hashTree/>
                <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="conta polls">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="script">vars.put("polls", String.valueOf((vars.get("polls") as int) + 1))</stringProp>
                  <stringProp name="cacheKey">true</stringProp>
                </JSR223PostProcessor>
                <hashTree/>
              </hashTree>
            </hashTree>
          </hashTree>
        </hashTree>

        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Pipeline - finalizar até status final">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">long chegada = vars.get("chegada") as long
String st = vars.get("pipelineStart")
long start = st ? st as long : 0L
long now = System.currentTimeMillis()
String status = vars.get("fullStatus")
// Motivo de quem não chegou ao NOTIFIED: erro na API antes de finalizar, timeout ou status final de falha.
String desfecho
if (!start) desfecho = vars.get("fullSessionId") == "NOT_FOUND" ? "ERRO_CRIAR_SESSAO"
                      : vars.get("documentId") == "NOT_FOUND" ? "ERRO_PRESIGN" : "ERRO_ANTES_DE_FINALIZAR"
else if (status == "NOTIFIED") desfecho = "OK"
else if (status in ["NOTIFICATION_FAILED", "ANALYSIS_FAILED", "FAILED", "CANCELLED"]) desfecho = "FALHA"
else desfecho = "TIMEOUT"
long total = start ? now - start : -1
String resumo = "protocolo=${vars.get('fullProtocolo')} sessionId=${vars.get('fullSessionId')} status=${status} desfecho=${desfecho} pipelineMs=${total} paginas=${vars.get('pdfPaginas')}"
SampleResult.setSuccessful(desfecho == "OK")
SampleResult.setResponseCode(desfecho == "OK" ? "NOTIFIED" : (desfecho == "FALHA" ? status : desfecho))
SampleResult.setResponseMessage(resumo)
SampleResult.setResponseData(resumo, "UTF-8")
// O tempo do pipeline (finalizar até o status final) vai para um CSV à parte:
// o JSR223Sampler não permite reescrever o início da própria amostra.
// Várias chegadas podem terminar ao mesmo tempo (modelo aberto): escrita sincronizada.
def out = new File(props.getProperty("pipelineCsv") ?: "pipeline.csv")
String linha = [new Date(start ?: chegada).format("HH:mm:ss"), vars.get("fullProtocolo"), vars.get("fullSessionId"),
                status ?: "", total, desfecho, chegada, start, now, vars.get("pdfNome"), vars.get("pdfPaginas"),
                vars.get("polls")].join(",") + "\n"
synchronized (props) {
  if (!out.exists()) out.text = "inicio,protocolo,sessionId,status,pipelineMs,desfecho,chegadaMs,finalizarMs,fimMs,pdf,paginas,polls\n"
  out &lt;&lt; linha
}
log.info("FLUXO COMPLETO: " + resumo)</stringProp>
          <stringProp name="cacheKey">true</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
